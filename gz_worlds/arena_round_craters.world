<?xml version="1.0" ?>
<!--
  NASA Lunabotics arena (Figure 9) - Gazebo Classic (Gazebo 11) / ROS 2 Humble

  Arena interior: 6.88 m (X) x 5.0 m (Y).  Origin (0,0,0) = center of the
  robot box in the starting zone (spawn the robot at 0 0 0).
  +X toward the construction zone side (right in the figure), +Y up the page,
  Z up.  The arena corners are therefore at x = -1.04 .. 5.84 and
  y = -1.02 .. 3.98.
  Excavation zone: x = -1.04 .. 1.46 m | Obstacle zone: x = 1.46 .. 5.84 m
  Starting zone and construction zone contents intentionally omitted.

  Obstacle positions were measured from the figure's pixel coordinates
  (~97.4 px/m), so they are approximate.

  Craters are circular holes cut through the floor (all in this one file).

  Launch:
    ros2 launch gazebo_ros gazebo.launch.py world:=/path/to/lunabotics_arena.world
-->
<sdf version="1.6">
  <world name="lunabotics_arena">

    <!-- Earth gravity by default. For lunar gravity use: 0 0 -1.62 -->
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.05 0.05 0.08 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>2.4 1.48 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1.0</direction>
    </light>


    <!-- ================= Arena floor with 3 circular cut-outs (stair-stepped boxes, 1 cm resolution) ================= -->
    <model name="arena_floor">
      <static>true</static>
      <link name="link">
        <collision name="c0"><pose>2.4000 -0.5325 -0.050 0 0 0</pose><geometry><box><size>6.8800 0.9750 0.10</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v0"><pose>2.4000 -0.5325 -0.050 0 0 0</pose><geometry><box><size>6.8800 0.9750 0.10</size></box></geometry><material><ambient>0.55 0.53 0.50 1</ambient><diffuse>0.55 0.53 0.50 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <collision name="c1"><pose>0.5564 -0.0400 -0.050 0 0 0</pose><geometry><box><size>3.1928 0.0100 0.10</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v1"><pose>0.5564 -0.0400 -0.050 0 0 0</pose><geometry><box><size>3.1928 0.0100 0.10</size></box></geometry><material><ambient>0.55 0.53 0.50 1</ambient><diffuse>0.55 0.53 0.50 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
